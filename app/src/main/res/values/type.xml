<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- EMPlay Type Scale -->

    <style name="TextAppearance.EMPlay.DisplayLg">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textFontWeight">500</item>
        <item name="lineHeight">28.8sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.EMPlay.DisplayMd">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textFontWeight">500</item>
        <item name="lineHeight">26.4sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.EMPlay.DisplaySm">
        <item name="android:fontFamily">@font/playfair_display</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textFontWeight">500</item>
        <item name="lineHeight">21.25sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.EMPlay.Section">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textFontWeight">600</item>
        <item name="lineHeight">19.5sp</item>
    </style>

    <style name="TextAppearance.EMPlay.Title">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textFontWeight">600</item>
        <item name="lineHeight">18.9sp</item>
    </style>

    <style name="TextAppearance.EMPlay.Body">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textFontWeight">400</item>
        <item name="lineHeight">20.8sp</item>
    </style>

    <style name="TextAppearance.EMPlay.Label">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textFontWeight">600</item>
        <item name="lineHeight">15.6sp</item>
    </style>

    <style name="TextAppearance.EMPlay.Caption">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textFontWeight">400</item>
        <item name="lineHeight">15.95sp</item>
    </style>

    <style name="TextAppearance.EMPlay.Micro">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.25</item>
        <item name="lineHeight">13sp</item>
    </style>

</resources>
