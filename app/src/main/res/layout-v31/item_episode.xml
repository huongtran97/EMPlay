<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Episode poster + number + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:gravity="center_vertical">

        <!-- Thumbnail (landscape 16:9) -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/episode_still"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/show_poster"
                android:background="@drawable/bg_poster_placeholder"
                android:clipToOutline="true" />

            <!-- Episode number circle -->
            <TextView
                android:id="@+id/episode_number"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="5dp"
                android:background="@drawable/bg_circle_dark"
                app:backgroundTint="@color/bg_rank_tint"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_chip"
                android:fontFamily="@font/playfair_display_medium"
                app:fontFamily="@font/playfair_display_medium"
                tools:text="5" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/episode_title"
                style="@style/TextAppearance.EMPlay.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_1"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="What She Left Behind" />

            <TextView
                android:id="@+id/episode_air_date"
                style="@style/TextAppearance.EMPlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_3"
                tools:text="52m · May 29" />

        </LinearLayout>

    </LinearLayout>

    <!-- Overview (optional expand) -->
    <TextView
        android:id="@+id/episode_overview"
        style="@style/TextAppearance.EMPlay.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/text_2"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/read_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/read_more"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_meta"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hairline divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10dp"
        android:background="@color/hairline_row" />

</LinearLayout>