<?xml version="1.0" encoding="utf-8"?>
<!--
    EMPlay · line_ticket_dash  (vertical dashed separator)

    FIX: android:shape="line" always draws HORIZONTAL — useless on a tall
    narrow View. Instead we use a layer-list of rectangle "dashes" spaced
    evenly from top to bottom via android:top offset.

    Apply to a View with:
        android:layout_width="2dp"
        android:layout_height="0dp"   ← constrained by ConstraintLayout
        android:background="@drawable/line_ticket_dash"
    No layerType needed.

    Each dash is 7dp tall, gap is 5dp → period = 12dp.
    Adjust the android:top values if your card height changes.
    For a fully dynamic version, use DashedLineDrawable.java (see note below).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="0dp"   android:bottom="0dp"><shape android:shape="rectangle"><solid android:color="@android:color/transparent"/></shape></item>

    <!-- Dash 1 -->
    <item android:top="0dp"   android:height="7dp"><shape android:shape="rectangle"><solid android:color="#80E3B566"/><corners android:radius="1dp"/></shape></item>
    <!-- Dash 2 -->
    <item android:top="12dp"  android:height="7dp"><shape android:shape="rectangle"><solid android:color="#80E3B566"/><corners android:radius="1dp"/></shape></item>
