<?xml version="1.0" encoding="utf-8"?>
<!--
    dot_active.xml
    Accent-gold pill shape for the currently active pagination dot.
    Width is animated from 8dp → 22dp in code (activateDot method).
    Fixed height: 8dp, fully rounded ends via cornerRadius = 4dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E3B566" />

    <corners android:radius="4dp" />

</shape>