<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08080F" />
            <corners android:radius="11dp" />
            <stroke
                android:width="0.5dp"
                android:color="#1C1C2C" />
        </shape>
    </item>

    <!-- Amber top-edge accent line: 1dp tall, inset from left/right, pinned to top -->
    <item
        android:top="0dp"
        android:bottom="0dp"
        android:left="12dp"
        android:right="12dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#C9943A" />
            <size android:height="1dp" />
            <corners android:radius="1dp" />
        </shape>
    </item>

</layer-list>