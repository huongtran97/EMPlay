<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_badge_theaters.xml
    Background drawable for the "Now in Theaters" badge.
    Semi-transparent red fill + red stroke + rounded corners.
    Usage: android:background="@drawable/bg_badge_theaters"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fill: #E53935 at ~15% opacity (26 / 255 ≈ 0.10 → use #1AE53935) -->
    <solid android:color="#1AE53935" />

    <!-- Stroke: #E53935 at ~40% opacity -->
    <stroke
        android:width="1dp"
        android:color="#66E53935" />

    <corners android:radius="4dp" />

</shape>