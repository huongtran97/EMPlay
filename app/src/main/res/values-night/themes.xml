<resources>
    <!-- Base application theme (night). Mirrors values/themes.xml — parent must NOT self-reference. -->
    <style name="Theme.EMPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bg_base</item>
        <item name="colorPrimaryVariant">@color/bg_surface</item>
        <item name="colorOnPrimary">@color/text_1</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <item name="bottomNavigationStyle">@style/Widget.EMPlay.BottomNavigationView</item>
    </style>
</resources>
