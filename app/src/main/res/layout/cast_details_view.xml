<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_dark"
                app:backgroundTint="#B30B0F19"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_1"
                android:scaleType="centerInside"
                android:contentDescription="@string/cd_back" />

            <!-- Header: Profile + Initial Ghost Glyph -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="13dp">

                <TextView
                    android:id="@+id/tvGhostGlyph"
                    style="@style/TextAppearance.EMPlay.DisplayLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.05"
                    android:textSize="@dimen/text_hero_l"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Z" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/cast_detail_image"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/cd_actor_photo"
                    android:background="@color/bg_surface"
                    app:shapeAppearanceOverlay="@style/EMPlay.Circle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cast_detail_image"
                    app:layout_constraintTop_toTopOf="@id/cast_detail_image"
                    app:layout_constraintBottom_toBottomOf="@id/cast_detail_image">

                    <TextView
                        android:id="@+id/cast_detail_name"
                        style="@style/TextAppearance.EMPlay.DisplayLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_1"
                        android:textSize="@dimen/text_headline"
                        tools:text="Zendaya" />

                    <TextView
                        android:id="@+id/cast_detail_meta"
                        style="@style/TextAppearance.EMPlay.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.5"
                        tools:text="Acting · Born Sep 1, 1996\nOakland, California" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Biography -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="13dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/cast_detail_biography"
                    style="@style/TextAppearance.EMPlay.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:ellipsize="end"
                    tools:text="American actress and singer..." />

                <TextView
                    android:id="@+id/read_more_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cast_more"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_divider_label"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Known For -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="13dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="9dp">

                <TextView
                    style="@style/TextAppearance.EMPlay.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cast_known_for"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cast_detail_credits_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/credit_item" />

            <!-- Filmography -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="13dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    style="@style/TextAppearance.EMPlay.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cast_filmography"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/credits_page_indicator"
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="42 titles ›" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilmography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="13dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_filmography" />

            <!-- Stub Pagination Bar -->
            <LinearLayout
                android:id="@+id/credits_pagination_bar"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone">
                <ImageButton android:id="@+id/credits_btn_prev" android:layout_width="1dp" android:layout_height="1dp" android:contentDescription="@null"/>
                <ImageButton android:id="@+id/credits_btn_next" android:layout_width="1dp" android:layout_height="1dp" android:contentDescription="@null"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
