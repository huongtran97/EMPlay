<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_chip_dark"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp">

    <!-- Provider logo from TMDB logo_path -->
    <ImageView
        android:id="@+id/iv_provider_logo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_provider_fallback"
        android:contentDescription="@string/cd_provider_logo" />

    <!-- Provider name -->
    <TextView
        android:id="@+id/tv_provider_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:textColor="@color/text_overview"
        android:textSize="@dimen/text_chip"
        android:maxLines="1" />

</LinearLayout>