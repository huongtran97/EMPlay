<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- HERO SECTION (palette background covers banner + meta) -->
        <LinearLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero_section"
            android:elevation="0dp"
            android:foreground="@drawable/bg_hero_section_border">

        <!-- HERO BANNER  -->
            <FrameLayout
                android:id="@+id/heroBannerContainer"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:clipChildren="false">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpTrendingBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </FrameLayout>

            <View
                android:id="@+id/viewBannerFade"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="-32dp"/>

            <!-- PAGINATION DOTS -->
            <LinearLayout
                android:id="@+id/llHeroDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <!-- NOW IN THEATERS badge -->
            <TextView
                android:id="@+id/tvHeroBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_theaters"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="@string/now_in_theaters"
                android:textColor="#E57373"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.09"
                android:textAllCaps="true"
                android:textStyle="bold" />

            <!-- MOVIE TITLE -->
            <TextSwitcher
                android:id="@+id/tvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="20dp"
                android:gravity="center" />

            <!-- Meta row -->
            <LinearLayout
                android:id="@+id/llHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Language-->
                <TextView
                    android:id="@+id/tvHeroYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/text_meta" />

                <!-- Dot separator -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#40FFFFFF"
                    android:layerType="software" />

                <!-- Star rating -->
                <TextView
                    android:id="@+id/tvHeroRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:textColor="#FFD600"
                    android:textSize="@dimen/text_meta"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- WHAT'S NEW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/show_icon"
                app:srcCompat="@drawable/ic_auto_awesome"
                app:tint="#F5C518" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/whats_new"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_section_header"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Filter buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsNewTvShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/tv_show"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_chip"
                android:textStyle="bold"
                app:backgroundTint="#E50914"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsNewMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movie"
                android:textAllCaps="false"
                android:textColor="#888888"
                android:textSize="@dimen/text_chip"
                app:backgroundTint="#1E1E1E"
                app:cornerRadius="20dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvWhatsNewSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:textColor="#666666"
                android:textSize="@dimen/text_chip" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWhatsNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:paddingHorizontal="14dp"
            android:nestedScrollingEnabled="false" />

        <!-- UPCOMING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="10dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/show_icon"
                app:srcCompat="@drawable/ic_calendar"
                app:tint="#C98A1A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upcoming"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_section_header"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/movie"
                android:textColor="#666666"
                android:textSize="@dimen/text_chip" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tv_show"
                android:textColor="#666666"
                android:textSize="@dimen/text_chip" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingTvShows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp" />

    </LinearLayout>

</ScrollView>