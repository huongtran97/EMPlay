<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="11dp"
    android:paddingVertical="8dp">

    <!-- TICKET CARD -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticketContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_ticket_hero"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- LEFT SECTION -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leftSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/separatorGroup"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1">

            <!-- Poster image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHeroPoster"
                android:layout_width="297dp"
                android:layout_height="143dp"
                android:background="#1E2A45"
                android:contentDescription="@string/show_poster"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/RoundedCorners.8dp"
                app:strokeColor="@color/bg_surface"
                app:strokeWidth="1dp"
                android:padding="1dp"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <!-- Title — up to 2 lines -->
            <TextView
                android:id="@+id/tvHeroTitle"
                style="@style/TextAppearance.EMPlay.DisplaySm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:lineSpacingMultiplier="1.15"
                app:layout_constraintTop_toBottomOf="@id/ivHeroPoster"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Tittle" />

            <!-- Genre · cert — sits at bottom of left section -->
            <TextView
                android:id="@+id/tvHeroMeta"
                style="@style/TextAppearance.EMPlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Meta data" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── SEPARATOR (punch holes + dashed line) ──
             Grouped in a barrier-free vertical chain.
             clipChildren=false on ticketContainer lets the
             circles overflow the card edge cleanly.         -->

        <!-- Top punch hole — straddles the top card edge -->
        <View
            android:id="@+id/punchTop"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_notch_hole"
            android:layout_marginTop="-9dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/leftSection"
            app:layout_constraintEnd_toStartOf="@id/rightSection" />

        <!-- Dashed tear line — single view, software layer for dash rendering -->
        <View
            android:id="@+id/separatorGroup"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layerType="software"
            android:layout_marginTop="3dp"
            android:background="@drawable/line_ticket_dash"
            app:layout_constraintTop_toBottomOf="@id/punchTop"
            app:layout_constraintBottom_toTopOf="@id/punchBottom"
            app:layout_constraintStart_toEndOf="@id/leftSection"
            app:layout_constraintEnd_toStartOf="@id/rightSection" />

        <!-- Bottom punch hole — straddles the bottom card edge -->
        <View
            android:id="@+id/punchBottom"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_notch_hole"
            android:layout_marginBottom="-9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/leftSection"
            app:layout_constraintEnd_toStartOf="@id/rightSection" />

        <!-- RIGHT STUB -->
        <LinearLayout
            android:id="@+id/rightSection"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- ADMIT ONE eyebrow -->
            <TextView
                android:id="@+id/tvAdmitOne"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:text="@string/memorabilia_admit_one"
                android:textColor="@color/text_3" />

            <!-- Gold hairline divider below eyebrow -->
            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_gravity="center_horizontal"
                android:alpha="0.4"
                android:background="@color/accent" />

            <!-- Large rating number — fills remaining vertical space -->
            <TextView
                android:id="@+id/tvHeroRating"
                style="@style/TextAppearance.EMPlay.DisplayLg"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/accent"
                tools:text="6.8" />

            <!-- Gold hairline divider above button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.15"
                android:background="@color/accent" />

            <!-- Trailer CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHeroTrailer"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="0dp"
                android:text="@string/action_trailer"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:gravity="center_vertical"
                app:backgroundTint="@color/accent"
                app:cornerRadius="7dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/on_accent"
                app:iconPadding="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>