<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · ORIGIN RESULTS VIEW
     Same structure as Genre Results — eyebrow shows "ORIGIN", default tab is TV -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Script-character watermark -->
    <TextView
        android:id="@+id/tvOriginGhostGlyph"
        android:layout_width="wrap_content"
        android:layout_height="113dp"
        android:layout_gravity="top|end"
        android:alpha="0.15"
        android:fontFamily="@font/playfair_display"
        app:fontFamily="@font/playfair_display"
        android:text="@string/ghost_glyph"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_hero_m" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="13dp">

            <TextView
                android:id="@+id/tv_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.18"
                android:text="@string/eyebrow_origin"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_chip" />

            <TextView
                android:id="@+id/tvOriginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_medium"
                app:fontFamily="@font/playfair_display_medium"
                android:text="@string/origin"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_subtitle" />

        </LinearLayout>

        <!-- Movies / TV Toggle -->
        <LinearLayout
            android:id="@+id/toggleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="13dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOriginMovies"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/label_movies"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_badge"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:minWidth="0dp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border"
                app:strokeWidth="@dimen/hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOriginTV"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="@string/label_tv"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:minWidth="0dp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="14dp" />

        </LinearLayout>



        <!-- Sort chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="13dp"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            tools:ignore="RtlSymmetry">

            <LinearLayout
                android:id="@+id/row_sort_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chipPopularity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/sort_popular"
                    android:textSize="@dimen/text_divider_label"
                    android:textColor="@color/chip_sort_text"
                    android:background="@drawable/bg_tab_chip_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:tag="chip_popular" />

                <TextView
                    android:id="@+id/chipRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/sort_top_rated"
                    android:textSize="@dimen/text_divider_label"
                    android:textColor="@color/chip_sort_text"
                    android:background="@drawable/bg_tab_chip_selector"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipNewest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/sort_newest"
                    android:textSize="@dimen/text_divider_label"
                    android:textColor="@color/chip_sort_text"
                    android:background="@drawable/bg_tab_chip_selector"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Filters row -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/btnFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/radius_m"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_adjustments"
                        app:tint="@color/text_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/action_filters"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/origin_results_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <!-- Infinite scroll loading indicator -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>