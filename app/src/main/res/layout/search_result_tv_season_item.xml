<?xml version="1.0" encoding="utf-8"?>
<!--
    EMPlay · Season tab chip item
    item_season_tab.xml  →  used by SeasonTabAdapter / rvSeasonTabs
    ──────────────────────────────────────────────────────
    Adapter toggles background between:
      selected  → @drawable/bg_tab_selected  (filled accent #E3B566, text on_accent)
      default   → @drawable/bg_chip          (stroke border, text text_2)
    ──────────────────────────────────────────────────────
-->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvSeasonTab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_chip"
    android:textColor="@color/text_2"
    android:textSize="11sp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    tools:text="Season 1" />