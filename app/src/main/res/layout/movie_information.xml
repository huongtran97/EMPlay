<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Poster -->
    <FrameLayout
        android:id="@+id/poster_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:elevation="8dp"
        android:background="@drawable/bg_poster_placeholder"
        android:clipToOutline="true"
        tools:targetApi="s"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/show_icon"
            android:scaleType="centerCrop" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/search_result_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/black_han_sans"
        android:text="@string/title"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poster_container" />

    <!-- Genres -->
    <TextView
        android:id="@+id/search_result_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="sans-serif"
        android:text="@string/genre"
        android:textAlignment="center"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_result_title" />

    <!-- Rating Bar -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="true"
        android:numStars="5"
        android:rating="0"
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:stepSize="0.5"
        android:theme="@style/RatingBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_result_genres" />

    <!-- Trailer + Favourite buttons -->
    <LinearLayout
        android:id="@+id/action_buttons"
        style="?android:attr/buttonBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar">

        <Button
            android:id="@+id/trailer_btn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#E53935"
            android:text="@string/trailer"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/add_to_library_btn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#1E1E1E"
            android:drawableStart="@drawable/movie_watchlist"
            android:drawablePadding="4dp"
            android:paddingHorizontal="16dp"
            android:text="@string/watch_list"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Meta info row -->
    <LinearLayout
        android:id="@+id/meta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_buttons">

        <TextView
            android:id="@+id/search_result_release_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/release_date"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="sans-serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/space"
            android:textColor="#444444"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/search_result_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_time"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="sans-serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/space"
            android:textColor="#444444"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/search_result_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

    <!-- Overview -->
    <TextView
        android:id="@+id/search_result_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:justificationMode="inter_word"
        tools:targetApi="o"
        android:text="@string/overview"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/meta_row" />

    <TextView
        android:id="@+id/read_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/read_more"
        android:textColor="#E53935"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/search_result_overview"
        app:layout_constraintTop_toBottomOf="@+id/search_result_overview"/>

</androidx.constraintlayout.widget.ConstraintLayout>