<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="20dp"
    android:paddingBottom="76dp">

    <!-- Ticket Stub Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emptyTicket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_ticket_stub"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Simulated Punch Holes -->
        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="-8dp"
            android:background="@drawable/bg_button_ticket_stub"
            app:backgroundTint="@color/bg_base"
            app:strokeColor="@color/border"
            app:strokeWidth="1.5dp"
            android:rotation="45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/bg_button_ticket_stub"
            app:backgroundTint="@color/bg_base"
            app:strokeColor="@color/border"
            app:strokeWidth="1.5dp"
            android:rotation="45"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_mylist_ticket"
            android:contentDescription="@null"
            app:tint="@color/text_3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvAdmitOne"
            style="@style/TextAppearance.EMPlay.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/memorabilia_admit_one"
            android:textColor="@color/text_3"
            android:letterSpacing="0.25"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            style="@style/TextAppearance.EMPlay.DisplaySm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/playfair_display_medium"
            app:fontFamily="@font/playfair_display_medium"
            android:text="@string/empty_watchlist_title"
            android:textColor="@color/text_2"
            app:layout_constraintTop_toBottomOf="@id/tvAdmitOne"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmptyBody"
            style="@style/TextAppearance.EMPlay.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/empty_watchlist_body"
            android:textColor="@color/text_3"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplore"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="11dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/empty_watchlist_cta"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            app:backgroundTint="@color/accent"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyBody"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
