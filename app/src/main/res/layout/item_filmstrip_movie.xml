<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="108dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPoster"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/show_poster"
        android:background="@color/bg_surface"
        app:shapeAppearanceOverlay="@style/RoundedCorners.8dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tvRank"
        style="@style/TextAppearance.EMPlay.Micro"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_margin="5dp"
        android:background="@drawable/bg_circle_dark"
        app:backgroundTint="@color/bg_rank_tint"
        android:gravity="center"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_badge"
        app:layout_constraintTop_toTopOf="@id/ivPoster"
        app:layout_constraintStart_toStartOf="@id/ivPoster"
        tools:text="1" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextAppearance.EMPlay.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/text_poster_rating"
        app:layout_constraintTop_toBottomOf="@id/ivPoster"
        tools:text="Shawshank" />

    <TextView
        android:id="@+id/tvMeta"
        style="@style/TextAppearance.EMPlay.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:textSize="@dimen/text_meta"
        tools:text="1994 · ★ 8.7" />

</androidx.constraintlayout.widget.ConstraintLayout>
