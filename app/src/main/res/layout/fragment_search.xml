<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · SEARCH VIEW
     ① Search field  ② Browse by Genre grid  ③ By Origin horizontal scroll  ④ Popular right now -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ① SEARCH FIELD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="13dp"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_3" />

                <TextView
                    android:id="@+id/tv_search_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_divider_label" />

            </LinearLayout>

            <!-- ② BROWSE BY GENRE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_genre_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0.18"
                    android:text="@string/search_section_genres"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/chip_genre_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/label_movies"
                    android:textColor="@color/on_accent"
                    android:textSize="@dimen/text_badge" />

                <TextView
                    android:id="@+id/chip_genre_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:text="@string/label_tv"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_badge" />

            </LinearLayout>

            <!-- Genre 2-column grid -->
            <GridLayout
                android:id="@+id/grid_genres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:rowCount="3"
                android:useDefaultMargins="false" />

            <!-- ③ BY ORIGIN -->
            <TextView
                android:id="@+id/tv_origin_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.18"
                android:paddingStart="13dp"
                android:paddingTop="16dp"
                android:paddingBottom="10dp"
                android:text="@string/search_section_origin"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_caption" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_origins"
                    android:layout_width="wrap_content"
                    android:layout_height="62dp"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- ④ POPULAR RIGHT NOW -->
            <TextView
                android:id="@+id/tv_popular_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.18"
                android:paddingStart="13dp"
                android:paddingTop="16dp"
                android:paddingBottom="10dp"
                android:text="@string/search_section_popular"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_caption" />

            <GridLayout
                android:id="@+id/grid_popular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="74dp"
                android:rowCount="1"
                android:useDefaultMargins="false" />

        </LinearLayout>

    </ScrollView>

    <!-- Glass bottom nav -->
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/component_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp" />

</FrameLayout>
