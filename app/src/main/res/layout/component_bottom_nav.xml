<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · BOTTOM NAV COMPONENT
     Glass-morphism pill bar: Home / Search / My List / Profile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/movie_bottom_navigation_container"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:background="@drawable/bg_bottom_nav"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            app:tint="@color/text_2" />

    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:id="@+id/nav_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_search"
            android:src="@drawable/ic_search"
            app:tint="@color/text_2" />

    </LinearLayout>

    <!-- My List (ticket icon) -->
    <LinearLayout
        android:id="@+id/nav_mylist"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_mylist"
            android:src="@drawable/ic_ticket"
            app:tint="@color/text_2" />

    </LinearLayout>

    <!-- Profile -->
    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/nav_profile"
            android:src="@drawable/ic_user"
            app:tint="@color/text_2" />

    </LinearLayout>

</LinearLayout>
