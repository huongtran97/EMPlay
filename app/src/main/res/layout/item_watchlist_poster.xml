<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_poster_placeholder"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ivPoster"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_bg" />

    <TextView
        android:id="@+id/tvPosterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="5dp"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvPosterRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_rating_badge"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:textColor="#F5C518"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/tvUpcomingDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="5dp"
        android:background="@drawable/bg_badge_red"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:visibility="gone" />

</FrameLayout>