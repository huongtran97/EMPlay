<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · DETAIL · MOVIE VIEW
     Header variant B: 16:9 backdrop + overlapping poster (−44dp lift)
     Sections: meta chips, actions, overview, Where to Watch, Cast, Collection, You May Also Like -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- BACKDROP 16:9 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <ImageView
                    android:id="@+id/img_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_dark_purple"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_chevron_left" />

            </FrameLayout>

            <!-- Poster overlapping backdrop + title block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-44dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/img_poster"
                    android:layout_width="92dp"
                    android:layout_height="132dp"
                    android:background="@drawable/bg_poster_placeholder"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/playfair_display"
                        android:text="Dune: Part Three"
                        android:textColor="@color/text_1"
                        android:textSize="@dimen/text_section_header" />

                    <!-- Genre + rating chips -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_inactive"
                            android:paddingStart="8dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="1dp"
                            android:text="Sci-fi"
                            android:textColor="@color/text_2"
                            android:textSize="@dimen/text_badge" />

                        <TextView
                            android:id="@+id/chip_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_chip_inactive"
                            android:paddingStart="8dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="1dp"
                            android:text="★ 8.2"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_badge" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Certification / runtime / release chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingTop="9dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/chip_cert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:text="14A"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_badge" />

                <TextView
                    android:id="@+id/chip_runtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:text="2h 46m"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_badge" />

                <TextView
                    android:id="@+id/chip_release"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:paddingStart="8dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="1dp"
                    android:text="22 May 2026"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_badge" />

            </LinearLayout>

            <!-- Action buttons: Watch Trailer + My List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <Button
                    android:id="@+id/btn_trailer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:padding="9dp"
                    android:text="@string/action_watch_trailer"
                    android:textColor="@color/on_accent"
                    android:textSize="@dimen/text_divider_label" />

                <LinearLayout
                    android:id="@+id/btn_my_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_stub"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_btn_mylist"
                        android:textColor="@color/text_1"
                        android:textSize="@dimen/text_badge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.1"
                        android:text="@string/memorabilia_admit_one"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

            </LinearLayout>

            <!-- Overview -->
            <TextView
                android:id="@+id/tv_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.6"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:text="Paul Atreides faces the consequences of the holy war he set in motion…"
                android:textColor="@color/text_2"
                android:textSize="@dimen/text_divider_label" />

            <!-- WHERE TO WATCH -->
            <TextView
                android:id="@+id/tv_where_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:paddingBottom="9dp"
                android:text="@string/detail_section_where_to_watch"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_meta" />

            <LinearLayout
                android:id="@+id/row_providers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp" />

            <!-- CAST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/tv_cast_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/detail_section_cast"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_meta" />

                <TextView
                    android:id="@+id/tv_all_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="@string/detail_all_cast"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_badge" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- PART OF collection -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="13dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.12"
                            android:text="@string/detail_part_of"
                            android:textColor="@color/text_3"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/tv_collection_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/playfair_display"
                            android:text="The Dune Collection"
                            android:textColor="@color/text_1"
                            android:textSize="@dimen/text_meta" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_collection_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 movies ›"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_badge" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- YOU MAY ALSO LIKE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/tv_also_like_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/detail_section_also_like"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_meta" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_also_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
