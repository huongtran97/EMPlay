<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Ghost glyph — native-script character, top-right, behind content -->
    <TextView
        android:id="@+id/tvOriginGhostGlyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-14dp"
        android:layout_marginEnd="6dp"
        android:fontFamily="@font/playfair_display"
        android:textSize="@dimen/text_hero_m"
        android:textColor="@color/text_1"
        android:alpha="0.05"
        android:importantForAccessibility="no"
        tools:text="한"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_dark"
        app:backgroundTint="#B30B0F19"
        android:src="@drawable/ic_chevron_left"
        app:tint="@color/text_1"
        android:scaleType="centerInside"
        android:contentDescription="@string/cd_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Filter button -->
    <ImageButton
        android:id="@+id/btnFilter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_filters"
        app:tint="@color/text_2"
        android:contentDescription="@string/cd_filter"
        android:scaleType="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header block: eyebrow + origin title -->
    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="50dp"
        android:paddingEnd="13dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextAppearance.EMPlay.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow_origin"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOriginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:textSize="@dimen/text_subtitle"
            android:textColor="@color/text_1"
            tools:text="Korean" />

    </LinearLayout>

    <!-- Movies / TV Toggle -->
    <LinearLayout
        android:id="@+id/toggleRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="13dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/headerBlock"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOriginMovies"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/label_movies"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/border"
            app:strokeWidth="@dimen/hairline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOriginTV"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:text="@string/label_tv"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="14dp" />

    </LinearLayout>

    <!-- Sort chip row -->
    <HorizontalScrollView
        android:id="@+id/sortChipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/toggleRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chipPopularity"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/sort_popular"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:tag="chip_popular" />

            <TextView
                android:id="@+id/chipRating"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp"
                android:text="@string/sort_top_rated"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipNewest"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp"
                android:text="@string/sort_newest"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/origin_results_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="13dp"
        android:paddingTop="4dp"
        android:paddingBottom="56dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/sortChipScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Infinite scroll loading indicator -->
    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:indeterminateTint="@color/accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>