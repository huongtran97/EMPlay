<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_dark"
        app:backgroundTint="#B30B0F19"
        android:src="@drawable/ic_chevron_left"
        app:tint="@color/text_1"
        android:scaleType="centerInside"
        android:contentDescription="@string/cd_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Header block -->
    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="50dp"
        android:paddingEnd="13dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextAppearance.EMPlay.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow_origin"
            android:layout_marginBottom="4dp" />

    </LinearLayout>

    <!-- Search bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="13dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="11dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border"
        app:strokeWidth="@dimen/hairline"
        app:layout_constraintTop_toBottomOf="@id/headerBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_3"
                android:contentDescription="@null" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOriginSearch"
                style="@style/TextAppearance.EMPlay.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textColor="@color/text_1"
                android:textColorHint="@color/text_3"
                android:padding="0dp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:contentDescription="@null"
                app:tint="@color/text_3" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Origins grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOriginGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="13dp"
        android:paddingBottom="56dp"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/spacing_5"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="1"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/genres_item" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvNoResults"
        style="@style/TextAppearance.EMPlay.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No results"
        android:visibility="gone"
        tools:ignore="HardcodedText"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>