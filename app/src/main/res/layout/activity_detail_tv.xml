<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · DETAIL · TV VIEW
     Backdrop + RETURNING SERIES badge + Next Episode card + Season/episode list -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- BACKDROP -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp">

                <ImageView
                    android:id="@+id/img_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_dark_teal"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_chevron_left" />

            </FrameLayout>

            <!-- Content below backdrop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="10dp"
                android:paddingEnd="13dp">

                <!-- RETURNING SERIES badge -->
                <TextView
                    android:id="@+id/badge_returning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_airing"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="@string/tv_badge_returning"
                    android:textColor="@color/airing"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tv_show_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="7dp"
                    android:fontFamily="@font/playfair_display"
                    android:text="Teach You a Lesson"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_headline" />

                <!-- Certification / seasons / rating chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_inactive"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:text="Thriller"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_badge" />

                    <TextView
                        android:id="@+id/chip_cert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:text="14+"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_badge" />

                    <TextView
                        android:id="@+id/chip_seasons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:text="2 seasons"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_badge" />

                    <TextView
                        android:id="@+id/chip_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:text="★ 8.1"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_badge" />

                </LinearLayout>

                <!-- NEXT EPISODE card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_next_episode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.12"
                                android:text="@string/tv_next_episode"
                                android:textColor="@color/text_3"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/tv_next_ep_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="S1 E7 · &quot;The Long Way Home&quot;"
                                android:textColor="@color/text_1"
                                android:textSize="@dimen/text_divider_label" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/badge_in_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_days"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="In 5 days"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_badge" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_trailer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:background="@drawable/bg_btn_primary"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="9dp"
                        android:text="@string/action_watch_trailer"
                        android:textColor="@color/on_accent"
                        android:textSize="@dimen/text_divider_label" />

                    <LinearLayout
                        android:id="@+id/btn_my_list"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_stub"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_btn_mylist"
                            android:textColor="@color/text_1"
                            android:textSize="@dimen/text_badge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.1"
                            android:text="@string/memorabilia_admit_one"
                            android:textColor="@color/text_3"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- EPISODES section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp">

                <TextView
                    android:id="@+id/tv_episodes_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingBottom="9dp"
                    android:text="@string/tv_section_episodes"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_meta" />

                <!-- Season tabs -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/row_season_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- Episode list -->
                <LinearLayout
                    android:id="@+id/list_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
