<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BACKDROP  +  BACK BUTTON -->
        <FrameLayout
            android:id="@+id/backdropContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/imgBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_backdrop"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_poster_gradient" />



        </FrameLayout>

        <!-- HEADER  (badge · title · chips · next-ep card · CTA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="10dp">

            <!-- Status badges row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- "RETURNING SERIES" / "ENDED" badge -->
                <TextView
                    android:id="@+id/tvReturningBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_badge_returning"
                    android:textSize="@dimen/text_badge"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/airing"
                    android:background="@drawable/bg_badge_airing"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <!-- "COMING SOON" badge — shown when first_air_date is in the future -->
                <TextView
                    android:id="@+id/coming_soon_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/coming_soon"
                    android:textSize="@dimen/text_badge"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_badge_amber"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Show title -->
            <TextView
                android:id="@+id/tvShowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="8dp"
                android:textSize="@dimen/text_headline"
                android:fontFamily="@font/playfair_display_medium"
                app:fontFamily="@font/playfair_display_medium"
                android:textColor="@color/text_1"
                tools:text="Teach You a Lesson" />

            <!-- Meta chips: genre · cert · seasons · country · rating -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:flexWrap="wrap"
                app:alignItems="center"
                app:justifyContent="flex_start">

                <TextView
                    android:id="@+id/chipGenre"
                    style="@style/Widget.EMPlay.Chip"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    tools:text="Thriller" />

                <TextView
                    android:id="@+id/chipCertification"
                    style="@style/Widget.EMPlay.Chip"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    android:visibility="gone"
                    tools:text="14+" />

                <TextView
                    android:id="@+id/chipSeasons"
                    style="@style/Widget.EMPlay.Chip"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    tools:text="2 seasons" />

                <TextView
                    android:id="@+id/chipCountry"
                    style="@style/Widget.EMPlay.Chip"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    tools:text="KR" />

                <TextView
                    android:id="@+id/chipRating"
                    style="@style/Widget.EMPlay.ChipAccent"
                    android:layout_marginBottom="5dp"
                    tools:text="★ 8.1" />

            </com.google.android.flexbox.FlexboxLayout>

            <TextView
                android:id="@+id/tv_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_2"
                android:textSize="@dimen/text_meta"
                android:lineSpacingExtra="3sp"
                android:ellipsize="end"
                tools:text="Overview" />

            <TextView
                android:id="@+id/read_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/read_more"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_meta"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Next Episode card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextEpisode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNextEpisodeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tv_next_episode"
                            android:textSize="@dimen/text_chip"
                            android:letterSpacing="0.12"
                            android:textColor="@color/text_3" />

                        <TextView
                            android:id="@+id/tvNextEpisodeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="@dimen/text_chip"
                            android:textStyle="bold"
                            android:textColor="@color/text_1"
                            tools:text='S1 E7 · "The Long Way Home"' />

                    </LinearLayout>

                    <!-- Countdown badge -->
                    <TextView
                        android:id="@+id/tvNextEpisodeDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_dark"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_badge"
                        android:textStyle="bold"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        tools:text="In 5 days" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CTA buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2.3"
                android:paddingBottom="@dimen/spacing_3">

                <Button
                    android:id="@+id/btnWatchTrailer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.3"
                    android:layout_marginEnd="7dp"
                    android:text="@string/action_watch_trailer"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:textColor="@color/on_accent"
                    android:backgroundTint="@color/accent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp" />

                <LinearLayout
                    android:id="@+id/btnMyList"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/ticket_tear_line"
                    android:layerType="software"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvMyList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_btn_mylist"
                        android:textSize="@dimen/text_chip"
                        android:textColor="@color/text_1" />

                    <TextView
                        android:id="@+id/tvAdmitOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/memorabilia_admit_one"
                        android:textSize="@dimen/text_chip"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_3" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- WHERE TO WATCH -->
        <include
            android:id="@+id/wtw_released"
            layout="@layout/wtw_released_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"/>

        <include
            android:id="@+id/wtw_unreleased"
            layout="@layout/wtw_unreleased_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:visibility="gone" />

        <!-- EPISODES SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Section header -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeasonTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_season_tab"
                tools:itemCount="3" />

            <!-- Episode list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false"
                tools:listitem="@layout/part_of_movie_movie"
                tools:itemCount="4" />

            <TextView
                android:id="@+id/tvSeeMoreEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:padding="4dp"
                android:text="@string/see_more"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/accent"
                android:visibility="gone" />

        </LinearLayout>

        <!-- CAST -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="9dp">

                <TextView
                    android:id="@+id/tvCastLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/detail_section_cast"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/accent"/>

                <TextView
                    android:id="@+id/tvAllCast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/detail_all_cast"
                    android:textSize="@dimen/text_divider_label"
                    android:textColor="@color/text_3"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:layout_gravity="center"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none" />

        </LinearLayout>

        <!-- YOU MAY ALSO LIKE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:paddingTop="20dp"
            android:paddingBottom="9dp">

            <TextView
                style="@style/TextAppearance.EMPlay.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_section_also_like"
                android:textSize="@dimen/text_section_header"
                android:textColor="@color/accent"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_result_suggestion_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/text_body"
            android:nestedScrollingEnabled="false" />


    </LinearLayout>
</androidx.core.widget.NestedScrollView>