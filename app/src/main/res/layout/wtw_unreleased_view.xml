<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_button_outline"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tv_expected_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:drawablePadding="5dp"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_calendar_small"
        app:drawableTint="@color/accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="June 15, 2025" />

    <View
        android:id="@+id/divider_countdown"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/hairline_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expected_label" />

    <LinearLayout
        android:id="@+id/countdown_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_countdown">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_provider"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_countdown"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.03"
                tools:text="06" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/d"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_provider"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_countdown"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.03"
                tools:text="01" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/h"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_provider"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_countdown"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.03"
                tools:text="16" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_provider"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">
            <TextView
                android:id="@+id/tv_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_countdown"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.03"
                tools:text="36" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/s"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_notify"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_provider"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/countdown_row">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="@null"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/release_notify"
            android:textSize="@dimen/text_meta"
            android:textColor="@color/accent"
            android:letterSpacing="0.07"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>