<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/ic_wtw_unreleased"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_tv"
        android:contentDescription="@null"
        app:tint="#E50914"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/tv_wtw_title_unreleased" />

    <TextView
        android:id="@+id/tv_wtw_title_unreleased"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/wtw"
        android:textColor="#888888"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif"
        app:layout_constraintStart_toEndOf="@+id/ic_wtw_unreleased"
        app:layout_constraintEnd_toStartOf="@+id/btn_region_unreleased"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btn_region_unreleased"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_dark"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_map_pin"
            android:layout_marginEnd="3dp"
            android:contentDescription="@null"
            app:tint="#555555" />

        <TextView
            android:id="@+id/tv_region_unreleased"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/region"
            android:textColor="#555555"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ic_calendar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_calendar"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        app:tint="#333333"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_wtw_title_unreleased" />

    <TextView
        android:id="@+id/tv_unreleased_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/not_released_yet"
        android:textColor="#666666"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_calendar" />

    <TextView
        android:id="@+id/release_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#C98A1A"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        tools:text="Releasing August 15, 2026"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_unreleased_label" />

    <LinearLayout
        android:id="@+id/countdown_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/release_date">

        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_countdown_block" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/tv_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/bebas_neue" tools:text="77" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/d" android:textColor="#555555" android:textSize="11sp" android:layout_marginTop="2dp" android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_countdown_block" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/tv_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/bebas_neue" tools:text="14" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/h" android:textColor="#555555" android:textSize="11sp" android:layout_marginTop="2dp" android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_countdown_block" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/tv_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/bebas_neue" tools:text="32" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m" android:textColor="#555555" android:textSize="11sp" android:layout_marginTop="2dp" android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_countdown_block" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/tv_seconds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:fontFamily="@font/bebas_neue" tools:text="08" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s" android:textColor="#555555" android:textSize="11sp" android:layout_marginTop="2dp" android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_notify"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="@string/release_notify"
        android:textSize="14sp"
        android:textColor="#C98A1A"
        android:fontFamily="sans-serif"
        android:backgroundTint="#1E1400"
        android:stateListAnimator="@null"
        android:drawableStart="@drawable/ic_bell"
        android:drawablePadding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/countdown_row" />

    <TextView
        android:id="@+id/tv_expected_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/expected"
        android:textColor="#3D3D3D"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_notify" />

    <LinearLayout
        android:id="@+id/layout_expected_providers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:alpha="0.45"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expected_label" />

    <TextView
        android:id="@+id/tv_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/provider_unconfirm_yet"
        android:textColor="#444444"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        app:drawableStartCompat="@drawable/bg_circle_dark"
        app:drawableTint="#444444"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_expected_providers"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>