<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_cinematic"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/ic_wtw_unreleased"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_tv"
        android:contentDescription="@null"
        app:tint="#E50914"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_wtw_title_unreleased"
        app:layout_constraintBottom_toBottomOf="@+id/tv_wtw_title_unreleased" />

    <TextView
        android:id="@+id/tv_wtw_title_unreleased"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:text="@string/wtw"
        android:textColor="#666677"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif"
        app:layout_constraintStart_toEndOf="@+id/ic_wtw_unreleased"
        app:layout_constraintEnd_toStartOf="@+id/btn_region_unreleased"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/btn_region_unreleased"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_cinematic"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:src="@drawable/ic_map_pin"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            app:tint="#555566" />

        <TextView
            android:id="@+id/tv_region_unreleased"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/region"
            android:textColor="#555566"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <View
        android:id="@+id/amber_glow"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_amber_glow"
        android:alpha="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_wtw_title_unreleased" />

    <ImageView
        android:id="@+id/ic_calendar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_calendar"
        android:padding="13dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_icon_amber"
        android:contentDescription="@null"
        app:tint="#C9943A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_wtw_title_unreleased" />

    <TextView
        android:id="@+id/tv_unreleased_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/not_released_yet"
        android:textColor="#E8E8F0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ic_calendar" />

    <TextView
        android:id="@+id/release_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#555566"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        tools:text="Expected soon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_unreleased_label" />

    <View
        android:id="@+id/divider_countdown"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="#1E1E2E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/release_date" />

    <LinearLayout
        android:id="@+id/countdown_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_countdown">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_countdown_block"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.03"
                tools:text="06" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/d"
                android:textColor="#C9943A"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_countdown_block"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.03"
                tools:text="01" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/h"
                android:textColor="#C9943A"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_countdown_block"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/tv_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.03"
                tools:text="16" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m"
                android:textColor="#C9943A"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_countdown_block"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">
            <TextView
                android:id="@+id/tv_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/bebas_neue"
                android:letterSpacing="0.03"
                tools:text="36" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/s"
                android:textColor="#C9943A"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_notify"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="@string/release_notify"
        android:textSize="13sp"
        android:textColor="#E5B96A"
        android:letterSpacing="0.07"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"
        android:drawableStart="@drawable/ic_bell"
        android:drawablePadding="8dp"
        android:background="@drawable/bg_notify_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/countdown_row" />

    <TextView
        android:id="@+id/tv_expected_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawableStart="@drawable/ic_calendar_small"
        android:drawablePadding="5dp"
        android:gravity="center_vertical"
        android:text="@string/expected"
        android:textColor="#333344"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        app:drawableTint="#333344"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_notify"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/layout_expected_providers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:alpha="0.35"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_notify" />

    <TextView
        android:id="@+id/tv_disclaimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/provider_unconfirm_yet"
        android:textColor="#333344"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:background="@drawable/bg_provider_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_notify"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>