<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141414">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <!-- Noir background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_noir_bg" />

                <!-- Poster -->
                <ImageView
                    android:id="@+id/season_detail_poster"
                    android:layout_width="110dp"
                    android:layout_height="158dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/show_poster"
                    android:background="@drawable/poster_border" />

                <!-- Info beside poster -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="140dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:text="@string/season"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#C0392B"
                        android:textSize="18sp"
                        android:letterSpacing="0.28"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/season_detail_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bebas_neue"
                        android:textColor="#F0EDE6"
                        android:textSize="38sp"
                        android:letterSpacing="0.03"
                        android:includeFontPadding="false" />

                    <!-- Pills row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/season_detail_episode_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_red"
                            android:textColor="#C0392B"
                            android:textSize="15sp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/season_detail_air_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/pill_dark"
                            android:textColor="#8A8580"
                            android:textSize="15sp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Red accent strip -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/gradient_red_strip" />

            <!-- Overview section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/overview"
                    android:textColor="#8A8580"
                    android:textSize="16sp"
                    android:letterSpacing="0.28"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/season_detail_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="4dp"
                    android:justificationMode="inter_word"
                    tools:targetApi="o"
                    android:textColor="#B8B4AD"
                    android:textSize="14sp"
                    android:maxLines="4"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/read_more_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/read_more"
                    android:textColor="#C0392B"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#282828" />

            <!-- Episodes label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="@string/episode"
                android:textColor="#8A8580"
                android:textSize="15sp"
                android:letterSpacing="0.28"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/season_detail_episodes_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>