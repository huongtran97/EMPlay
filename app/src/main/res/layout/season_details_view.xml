<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Hero banner (poster + info side by side) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/bg_surface">

                <ImageView
                    android:id="@+id/season_detail_poster"
                    android:layout_width="110dp"
                    android:layout_height="158dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="20dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/show_poster"
                    android:background="@drawable/bg_poster_placeholder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="146dp"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:text="@string/season"
                        style="@style/TextAppearance.EMPlay.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent" />

                    <TextView
                        android:id="@+id/season_detail_name"
                        style="@style/TextAppearance.EMPlay.DisplayLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_1"
                        tools:text="Season 1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/season_detail_episode_count"
                            style="@style/GenreChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="10 episodes" />

                        <TextView
                            android:id="@+id/season_detail_air_date"
                            style="@style/GenreChipStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            tools:text="2024" />

                    </LinearLayout>

                </LinearLayout>


            </FrameLayout>

            <!-- Overview section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/season_detail_overview"
                    style="@style/TextAppearance.EMPlay.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:textColor="@color/text_2" />

                <TextView
                    android:id="@+id/read_more_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/read_more"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_meta"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Episodes section header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginBottom="4dp"
                android:text="@string/tv_section_episodes"
                style="@style/TextAppearance.EMPlay.Micro"
                android:textColor="@color/accent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/season_detail_episodes_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>