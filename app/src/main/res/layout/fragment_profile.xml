<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · PROFILE VIEW
     Member card (memorabilia) + stats row + mini watchlist preview + settings rows -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Brand wordmark -->
            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display_medium"
                android:letterSpacing="0.1"
                android:paddingStart="13dp"
                android:paddingTop="16dp"
                android:paddingEnd="13dp"
                android:text="@string/brand_name"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_chip" />

            <!-- MEMBER CARD -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="13dp">

                <!-- Card body -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_member_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <!-- Club / card label row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/playfair_display_medium"
                            android:letterSpacing="0.18"
                            android:text="@string/profile_club"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_badge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.12"
                            android:text="@string/profile_member_card"
                            android:textColor="@color/text_3"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- Avatar + name row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar circle -->
                        <TextView
                            android:id="@+id/tv_avatar_initial"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_avatar_circle"
                            android:fontFamily="@font/playfair_display"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_body" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_display_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:text="Minh Anh"
                                android:textColor="@color/text_1"
                                android:textSize="@dimen/text_chip" />

                            <TextView
                                android:id="@+id/tv_tmdb_handle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="TMDB · @minhanh_review"
                                android:textColor="@color/text_3"
                                android:textSize="@dimen/text_badge" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_member_since"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.12"
                        android:text="MEMBER SINCE JUNE 2026"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

                <!-- Left punch-hole notch -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="-7dp"
                    android:background="@drawable/bg_notch_hole" />

                <!-- Right punch-hole notch -->
                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="-7dp"
                    android:background="@drawable/bg_notch_hole" />

            </FrameLayout>

            <!-- STATS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_stats_row"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_watchlist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display"
                        android:text="42"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_watchlist"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_badge" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/divider_dashed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_favorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display"
                        android:text="18"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_favorites"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_badge" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/divider_dashed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_rated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/playfair_display"
                        android:text="27"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_rated"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_badge" />

                </LinearLayout>

            </LinearLayout>

            <!-- MINI WATCHLIST PREVIEW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingTop="14dp"
                android:paddingEnd="13dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_mylist_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/mylist_title"
                    android:textColor="@color/text_1"
                    android:textSize="@dimen/text_meta" />

                <TextView
                    android:id="@+id/tv_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="@string/action_see_all"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_badge" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="13dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_watchlist_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="104dp"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- SETTINGS rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingTop="8dp"
                android:paddingEnd="13dp"
                android:paddingBottom="74dp">

                <!-- Theme row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_moon"
                        android:tint="@color/text_2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_theme"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_divider_label" />

                    <TextView
                        android:id="@+id/tv_theme_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/theme_deep_blue"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_divider_label" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ›"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_divider_label" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/hairline_row" />

                <!-- Sign out -->
                <TextView
                    android:id="@+id/tv_sign_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="11dp"
                    android:paddingStart="0dp"
                    android:text="@string/action_sign_out"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_divider_label" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Glass bottom nav -->
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/component_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp" />

</FrameLayout>
