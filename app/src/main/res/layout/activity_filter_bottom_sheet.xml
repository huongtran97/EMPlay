<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/border" />

    <!-- Sheet title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/action_filters"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <!-- Sort by section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/label_sort_by"
        android:textColor="@color/text_3"
        android:textSize="@dimen/text_badge"
        android:textAllCaps="true"
        android:letterSpacing="0.08" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/filterChipPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sort_popular"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/filterChipRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:text="@string/sort_top_rated"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/filterChipNewest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"
                android:text="@string/sort_newest"
                android:textSize="@dimen/text_divider_label"
                android:textColor="@color/chip_sort_text"
                android:background="@drawable/bg_tab_chip_selector"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Year range section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_year_range"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvYearRangeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_divider_label"
            android:fontFamily="@font/inter"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- RangeSlider: valueFrom/valueTo/values set in code to avoid AAPT2 issues -->
    <com.google.android.material.slider.RangeSlider
        android:id="@+id/yearRangeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        app:thumbColor="@color/accent"
        app:trackColorActive="@color/accent"
        app:trackColorInactive="@color/border"
        app:haloColor="@android:color/transparent"
        app:labelBehavior="gone" />

    <!-- Apply button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/btn_apply"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/text_chip"
        android:textStyle="bold"
        app:backgroundTint="@color/accent"
        app:cornerRadius="@dimen/radius_pill" />

</LinearLayout>