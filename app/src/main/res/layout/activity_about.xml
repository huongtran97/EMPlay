<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/back_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back" />

            </RelativeLayout>

            <!-- App Logo + Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:layout_width="128dp"
                    android:layout_height="124dp"
                    android:contentDescription="@string/emplay_logo"
                    android:src="@drawable/e_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/emplay"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_app_name"
                    android:fontFamily="@font/bebas_neue"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#777777"
                    android:textSize="@dimen/text_meta"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- APP INFO section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/app_info"
                android:textColor="#777777"
                android:textSize="@dimen/text_chip"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#111111"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_movies_and_tv_shows_companion"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_chip"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1E1E1E" />

                <ImageView
                    android:id="@+id/tmdb_logo"
                    android:layout_width="85dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/the_movie_database"
                    android:src="@drawable/tmdb_logo1"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tmdb"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_chip"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- PRIVACY POLICY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/privacy_policy"
                android:textColor="#777777"
                android:textSize="@dimen/text_chip"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/privacy_policy_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#111111"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/policy_title"
                    android:textColor="#CCCCCC"
                    android:textSize="@dimen/text_chip"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ic"
                    android:textColor="#555555"
                    android:textSize="@dimen/text_section_header" />

            </LinearLayout>

            <!-- CREDITS section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/credits"
                android:textColor="#777777"
                android:textSize="@dimen/text_chip"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#111111"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <!-- Developer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/developer"
                        android:textColor="#777777"
                        android:textSize="@dimen/text_chip"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/author"
                        android:textColor="#CCCCCC"
                        android:textSize="@dimen/text_chip"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1E1E1E" />

                <!-- Libraries -->
                <LinearLayout
                    android:id="@+id/libraries_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/libraries"
                        android:textColor="#CCCCCC"
                        android:textSize="@dimen/text_chip"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ic"
                        android:textColor="#555555"
                        android:textSize="@dimen/text_section_header" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>

