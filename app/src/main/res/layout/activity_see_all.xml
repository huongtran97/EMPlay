<?xml version="1.0" encoding="utf-8"?>
<!-- EMPlay · SEE ALL VIEW
     Eyebrow "FROM HOME", title, subtitle (count), 3-column ranked poster grid + loading footer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- ★ watermark -->
    <TextView
        android:id="@+id/tv_watermark_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:alpha="0.045"
        android:fontFamily="@font/playfair_display_medium"
        android:text="★"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_hero_xl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_chevron_left" />

        </FrameLayout>

        <!-- Header block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="50dp"
            android:paddingEnd="13dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.18"
                android:text="@string/eyebrow_from_home"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/playfair_display"
                android:text="@string/home_section_top_rated"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_headline" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Movies · 250 titles"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_badge" />

        </LinearLayout>

        <!-- Scrollable 3-column grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_all_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="13dp"
            android:paddingEnd="13dp" />

        <!-- Loading more footer -->
        <TextView
            android:id="@+id/tv_loading_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/list_loading_more"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge"
            android:visibility="visible" />

    </LinearLayout>

</FrameLayout>
