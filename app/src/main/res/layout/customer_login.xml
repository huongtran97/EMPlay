<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: static fallback shown before dynamic posters arrive -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Layer 2: 2-column × 4-row poster mosaic (invisible until loaded) -->
    <LinearLayout
        android:id="@+id/poster_mosaic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:id="@+id/poster_0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:ignore="NestedWeights" />
            <ImageView android:id="@+id/poster_1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:id="@+id/poster_2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:ignore="NestedWeights" />
            <ImageView android:id="@+id/poster_3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:id="@+id/poster_4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:ignore="NestedWeights" />
            <ImageView android:id="@+id/poster_5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView android:id="@+id/poster_6"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:ignore="NestedWeights" />
            <ImageView android:id="@+id/poster_7"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- Layer 3: bg_base at 60% opacity per spec §6.02 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990B0F19" />

    <!-- Layer 4: content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Brand -->
        <ImageView
            android:layout_width="71dp"
            android:layout_height="77dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_logo_punch_e"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emplay"
            android:textColor="@color/text_1"
            android:textSize="@dimen/text_display_m"
            android:fontFamily="@font/playfair_display"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_tagline"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_meta"
            android:fontFamily="@font/inter"
            android:layout_marginBottom="40dp" />

        <!-- TMDB button: accent fill, pill shape -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tmdb_sign_in"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/on_accent"
            android:fontFamily="@font/inter"
            android:textSize="@dimen/text_meta"
            android:text="@string/login_tmdb"
            android:stateListAnimator="@null"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/tmdb_logo"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            android:layout_marginBottom="4dp" />

        <!-- Progress indicator shown during TMDB token fetch -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Google button: accent fill, pill shape -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_sign_in"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/on_accent"
            android:fontFamily="@font/inter"
            android:textSize="@dimen/text_meta"
            android:text="@string/login_google"
            android:stateListAnimator="@null"
            app:cornerRadius="@dimen/radius_pill"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            android:layout_marginBottom="4dp" />

        <!-- "or" divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="@color/border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/or"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_divider_label"
                android:fontFamily="@font/inter"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="@color/border" />

        </LinearLayout>

        <!-- Guest button: outlined, pill shape -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guest_continue"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/inter"
            android:textSize="@dimen/text_meta"
            android:textColor="@color/text_3"
            android:stateListAnimator="@null"
            android:text="@string/login_guest"
            app:cornerRadius="@dimen/radius_pill"
            app:strokeColor="@color/border"
            app:strokeWidth="0.5dp"
            android:layout_marginBottom="20dp" />

        <!-- Legal note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legal_terms_note"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- TMDB attribution — required by TMDB API ToS (§10.1) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:src="@drawable/tmdb_logo"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_attribution"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_badge"
                android:fontFamily="@font/inter"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
