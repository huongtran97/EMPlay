<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <!-- Dark overlay so text is readable over the image -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"/>

    <!-- Content: logo + title + buttons, centered vertically -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="71dp"
            android:layout_height="77dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@null"
            android:src="@drawable/e_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emplay"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_app_name"
            android:fontFamily="@font/bebas_neue"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_movies_and_tv_shows_companion"
            android:textColor="#777777"
            android:textSize="@dimen/text_meta"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="40dp"/>

        <!-- Google Sign-In -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_sign_in"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="5dp"
            android:backgroundTint="#3A3737"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/text_chip"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp"
            android:text="@string/continue_with_google"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null" />

        <!-- TMDB Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tmdb_sign_in"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="5dp"
            android:backgroundTint="#3A3737"
            android:text="@string/continue_with_tmdb"
            android:textColor="#FFFFFF"
            app:icon="@drawable/tmdb_logo"
            android:textSize="@dimen/text_chip"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/tmdb"
            android:textColor="#555555"
            android:textSize="@dimen/text_badge" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/or"
                android:textColor="#555555"
                android:textSize="@dimen/text_divider_label"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0.5dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guest_continue"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            android:text="@string/guest"
            android:textColor="#777777"
            android:textSize="@dimen/text_chip"
            app:cornerRadius="12dp" />

    </LinearLayout>


</FrameLayout>