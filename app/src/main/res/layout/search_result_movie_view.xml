<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/search_result_fragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- Movie info card -->
                <include
                    android:id="@+id/movie_info"
                    layout="@layout/movie_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Cast Header -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="13dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="9dp">

                    <TextView
                        style="@style/TextAppearance.EMPlay.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_section_cast"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        style="@style/TextAppearance.EMPlay.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_all_cast"
                        android:textColor="@color/text_3"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Cast RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_cast_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <!-- Suggestion Header -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="13dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="9dp">

                    <TextView
                        style="@style/TextAppearance.EMPlay.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_section_also_like"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Suggestion Pagination Bar (Stub for compatibility) -->
                <LinearLayout
                    android:id="@+id/suggestion_pagination_bar"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/suggestion_page_indicator" android:layout_width="1dp" android:layout_height="1dp"/>
                    <ImageButton android:id="@+id/suggestion_btn_prev" android:layout_width="1dp" android:layout_height="1dp" android:contentDescription="@null"/>
                    <ImageButton android:id="@+id/suggestion_btn_next" android:layout_width="1dp" android:layout_height="1dp" android:contentDescription="@null"/>
                </LinearLayout>

                <!-- Suggestion RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_suggestion_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
