<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/search_result_fragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0A0A">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Movie info card (bound directly via ViewBinding) -->
                <include
                    android:id="@+id/movie_info"
                    layout="@layout/movie_information"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Divider -->
                <View
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:background="#1E1E1E" />

                <!-- Cast label -->
                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="CAST"
                    android:textColor="#777777"
                    android:textSize="@dimen/text_badge"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium" />

                <!-- Cast RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_cast_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <!-- Divider -->
                <View
                    android:id="@+id/view2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:background="#1E1E1E" />

                <!-- Suggestion label -->
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="YOU MIGHT ALSO LIKE"
                    android:textColor="#777777"
                    android:textSize="@dimen/text_badge"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium" />

                <!-- Suggestion RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_result_suggestion_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- Suggestion Pagination Bar -->
                <LinearLayout
                    android:id="@+id/suggestion_pagination_bar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/suggestion_btn_prev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_arrow_back"
                        android:background="@drawable/rounded_btn_bg"
                        android:contentDescription="Previous page"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/suggestion_page_indicator"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#888888"
                        android:textSize="@dimen/text_meta" />

                    <ImageButton
                        android:id="@+id/suggestion_btn_next"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:background="@drawable/rounded_btn_bg"
                        android:contentDescription="Next page" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>