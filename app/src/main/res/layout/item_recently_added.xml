<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="9dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="170dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_poster_placeholder"
        android:clipToOutline="true"
        tools:targetApi="s">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/show_poster"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="#CCCCCC"
            android:textSize="@dimen/text_meta" />

        <TextView
            android:id="@+id/tvSavedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#444444"
            android:textSize="@dimen/text_badge" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_type_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textSize="@dimen/text_badge"
        android:textStyle="bold" />

</LinearLayout>