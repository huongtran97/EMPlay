<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <ImageView
            android:id="@+id/tvBrandName"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo_wordmark"
            android:contentDescription="@string/brand_name"/>

        <!-- Member Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/memberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="13dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_member_card"
            android:padding="13dp">

            <!-- Simulated Punch Holes -->
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="-8dp"
                android:background="@drawable/bg_member_card"
                app:backgroundTint="@color/bg_base"
                app:strokeColor="#66E3B566"
                app:strokeWidth="0.5dp"
                android:rotation="45"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="-8dp"
                android:background="@drawable/bg_member_card"
                app:backgroundTint="@color/bg_base"
                app:strokeColor="#66E3B566"
                app:strokeWidth="0.5dp"
                android:rotation="45"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvClubLabel"
                style="@style/TextAppearance.EMPlay.DisplaySm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_club"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_badge"
                android:letterSpacing="0.2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvMemberCardLabel"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_member_card"
                android:textColor="@color/text_3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Guest state (shown when not authenticated) -->
            <LinearLayout
                android:id="@+id/guestBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvClubLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browsing_as_guest"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_meta" />

                <Button
                    android:id="@+id/btnGuestSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/guest_create_account"
                    android:textColor="@color/on_accent"
                    android:textSize="@dimen/text_divider_label"
                    android:backgroundTint="@color/accent"
                    android:paddingHorizontal="16dp"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/userInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvClubLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/civAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/avatar"
                    app:civ_border_color="@color/border"
                    app:civ_border_width="0.5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        style="@style/TextAppearance.EMPlay.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_name"
                        android:textColor="@color/text_1"
                        android:textSize="@dimen/text_chip" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        style="@style/TextAppearance.EMPlay.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="TMDB · @username"
                        android:textColor="@color/text_3" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvMemberSince"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/profile_member_since"
                android:textColor="@color/text_3"
                app:layout_constraintTop_toBottomOf="@id/userInfo"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="13dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_member_card"
            app:backgroundTint="@color/bg_surface"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/tvMoviesCount"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_watchlist"
                    android:textColor="@color/text_3" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/line_ticket_dash"
                android:alpha="0.3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/tvTvShowsCount"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_favorites"
                    android:textColor="@color/text_3" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/line_ticket_dash"
                android:alpha="0.3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp">
                <TextView
                    android:id="@+id/tvTopGenre"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_no_data"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_rated"
                    android:textColor="@color/text_3" />
            </LinearLayout>

        </LinearLayout>

        <!-- Taste Profile (Hidden for now to match layout compatibility) -->
        <LinearLayout
            android:id="@+id/llTasteProfileHeader"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/llTasteProfile"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:orientation="vertical" />

        <!-- Recently Saved Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="13dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mylist_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvRecentlySavedSeeAll"
                style="@style/TextAppearance.EMPlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_see_all"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentlySaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Settings List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="13dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp"
                android:paddingHorizontal="1dp">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/text_2"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/settings_theme"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_divider_label" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_deep_blue"
                    android:textColor="@color/text_3" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/hairline" android:background="@color/border" android:alpha="0.3" />

            <LinearLayout
                android:id="@+id/llAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="11dp">
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_2"
                        android:contentDescription="@null" />
                    <TextView
                        style="@style/TextAppearance.EMPlay.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/about"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_divider_label" />
                </LinearLayout>

                <!-- TMDB attribution — mandatory per §10.1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="11dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:src="@drawable/tmdb_logo1"
                        android:scaleType="fitStart"
                        android:contentDescription="@string/tmdb" />
                    <TextView
                        style="@style/TextAppearance.EMPlay.Micro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/tmdb_data_attribution"
                        android:textColor="@color/text_3" />
                </LinearLayout>

            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="@dimen/hairline" android:background="@color/border" android:alpha="0.3" />
            <View android:id="@+id/dividerDeleteAccount" android:layout_width="match_parent" android:layout_height="@dimen/hairline" android:background="@color/border" android:alpha="0.3" />

            <LinearLayout
                android:id="@+id/llLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp"
                android:paddingHorizontal="1dp"
                tools:ignore="UseCompoundDrawables">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_sign_out"
                    app:tint="@color/error"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvLogoutLabel"
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/action_sign_out"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_divider_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="11dp"
                android:paddingHorizontal="1dp">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_3"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/delete_account"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_divider_label" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
