<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Avatar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:id="@+id/profile_avatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/avatar"
                    android:contentDescription="Profile avatar" />

                <TextView
                    android:id="@+id/profile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="#777777"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="#1E1E1E"/>

            <!-- Saved Movies Section -->
            <TextView
                android:id="@+id/movie_liked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="SAVED MOVIES"
                android:textColor="#777777"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liked_movie_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>

            <!-- Saved TV Shows Section -->
            <TextView
                android:id="@+id/tv_liked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="SAVED TV SHOWS"
                android:textColor="#777777"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liked_tv_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                android:scrollbars="none"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                android:background="#1E1E1E"/>

            <!-- Logout Button — outlined red -->
            <Button
                android:id="@+id/logout_account_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:text="Logout"
                android:textColor="#E53935"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="@android:color/transparent"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#E53935"
                app:strokeWidth="1dp"/>

            <!-- Delete Account — subtle text button -->
            <Button
                android:id="@+id/delete_account_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="Delete Account"
                android:textColor="#444444"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:backgroundTint="@android:color/transparent"
                android:stateListAnimator="@null"/>

            <!-- About link -->
            <Button
                android:id="@+id/about_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:text="About"
                android:textColor="#444444"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:backgroundTint="@android:color/transparent"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
