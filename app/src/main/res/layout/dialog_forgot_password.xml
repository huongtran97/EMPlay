<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    android:paddingBottom="32dp"
    tools:ignore="Overdraw">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/border" />

    <!-- Sheet title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/inter"
        android:text="@string/forgot_password_title"
        android:textColor="@color/text_1"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/inter"
        android:lineSpacingMultiplier="1.5"
        android:text="@string/forgot_password_subtitle"
        android:textColor="@color/text_3"
        android:textSize="@dimen/text_chip" />

    <!-- TMDB section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_field"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/tmdb_logo"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/forgot_password_tmdb_label"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_meta"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/forgot_password_tmdb_body"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_tmdb"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/accent"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/forgot_password_tmdb_cta"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/text_meta"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border" />

    <!-- Google section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_field"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_google"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp"
                app:tint="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/forgot_password_google_label"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_meta"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/forgot_password_google_body"
            android:textColor="@color/text_3"
            android:textSize="@dimen/text_badge" />

    </LinearLayout>

</LinearLayout>