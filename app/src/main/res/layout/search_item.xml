<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#141414"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="130dp">

        <!-- Poster -->
        <ImageView
            android:id="@+id/search_poster"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:contentDescription="@string/show_poster"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/search_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_section_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_poster"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rating Bar -->
        <TextView
            android:id="@+id/tvPosterRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/_0_0"
            android:textColor="#FFC107"
            android:textSize="@dimen/text_poster_rating"
            app:layout_constraintStart_toEndOf="@+id/search_poster"
            app:layout_constraintTop_toBottomOf="@+id/search_title" />

        <!-- Release Date -->
        <TextView
            android:id="@+id/search_release_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/release_date"
            android:textColor="#555555"
            android:textSize="@dimen/text_poster_rating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_poster"
            app:layout_constraintTop_toBottomOf="@+id/tvPosterRating" />

        <!-- Language -->
        <TextView
            android:id="@+id/search_language"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif"
            android:text="@string/language"
            android:textColor="#555555"
            android:textSize="@dimen/text_poster_rating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_poster"
            app:layout_constraintTop_toBottomOf="@+id/search_release_date" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>