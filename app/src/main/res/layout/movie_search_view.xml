<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Header -->
    <TextView
        android:id="@+id/movie_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/black_han_sans"
        android:text="Search"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>

    <!-- Movie / TV Show Toggle -->
    <LinearLayout
        android:id="@+id/horizontal_menu"
        android:layout_width="220dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/toggle_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/movie_search">

        <LinearLayout
            android:id="@+id/menu_movie_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/toggle_selected_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/menu_movie"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="movie"
                android:src="@drawable/movie"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie"
                android:fontFamily="@font/black_han_sans"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_tvshow_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/menu_tvshow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="tv_show"
                android:src="@drawable/tv_show"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV Show"
                android:fontFamily="@font/black_han_sans"
                android:textColor="#9E9E9E"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Search Bar -->
    <FrameLayout
        android:id="@+id/search_bar_container"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_bar_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_menu">

        <EditText
            android:id="@+id/input_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="44dp"
            android:background="@android:color/transparent"
            android:hint="Search movies, TV shows..."
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/search_movie_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:src="@drawable/movie_search"
            android:contentDescription="Search"/>

    </FrameLayout>

    <!-- Genres Label -->
    <TextView
        android:id="@+id/genres_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="Browse by Genre"
        android:textColor="#9E9E9E"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar_container"/>

    <!-- Genres RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/genres_recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genres_label"/>

    <!-- Search Results -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genres_recycler_view">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>