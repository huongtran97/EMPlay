<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <!-- Member Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/memberCard"
            android:layout_width="match_parent"
            android:layout_height="233dp"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_member_card"
            android:padding="13dp">

            <TextView
                android:id="@+id/tvMemberCardLabel"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_member_card"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_caption"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/userInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMemberCardLabel">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/civAvatar"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:src="@drawable/avatar"
                    app:civ_border_color="@color/border"
                    app:civ_border_width="0.5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        style="@style/TextAppearance.EMPlay.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_name"
                        android:textColor="@color/text_1"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        style="@style/TextAppearance.EMPlay.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_3"
                        android:textSize="@dimen/text_chip"
                        tools:text="@string/user_email" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvMemberSince"
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="@string/profile_member_since"
                android:textColor="@color/text_3"
                android:textSize="@dimen/text_chip"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userInfo" />

            <ImageView
                android:id="@+id/tvBrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:contentDescription="@string/brand_name"
                android:src="@drawable/ic_logo_wordmark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMemberSince" />

            <LinearLayout
                android:id="@+id/guestBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userInfo">

                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browsing_as_guest"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_meta" />


            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_stats_row"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:id="@+id/tvMoviesCount"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_watchlist"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:background="@drawable/line_ticket_dash" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:id="@+id/tvTvShowsCount"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_favorites"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:background="@drawable/line_ticket_dash" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:id="@+id/tvTopGenre"
                    style="@style/TextAppearance.EMPlay.DisplaySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_no_data"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_rated"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

        </LinearLayout>

        <!-- Taste Profile (Hidden) -->
        <LinearLayout
            android:id="@+id/llTasteProfileHeader"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:orientation="horizontal"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/llTasteProfile"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Recently Saved Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="14dp"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <TextView
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mylist_title"
                android:textSize="@dimen/text_section_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvRecentlySavedSeeAll"
                style="@style/TextAppearance.EMPlay.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_see_all"
                android:textSize="@dimen/text_meta"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentlySaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Settings List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/text_2" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/settings_theme"
                    android:textColor="@color/text_2"
                    android:textSize="@dimen/text_body" />
                <TextView
                    android:id="@+id/tv_theme_value"
                    style="@style/TextAppearance.EMPlay.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_meta" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:alpha="0.3"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/llAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="1dp"
                android:paddingEnd="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/text_2" />
                    <TextView
                        style="@style/TextAppearance.EMPlay.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/about"
                        android:textColor="@color/text_2"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:alpha="0.3"
                android:background="@color/border" />

            <View
                android:id="@+id/dividerDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:alpha="0.3"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/llLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                tools:ignore="UseCompoundDrawables">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sign_out"
                    app:tint="@color/error" />
                <TextView
                    android:id="@+id/tvLogoutLabel"
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/action_sign_out"
                    android:textColor="@color/error"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:alpha="0.3"
                android:background="@color/border" />

            <LinearLayout
                android:id="@+id/llDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="1dp"
                android:paddingEnd="1dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="21dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_3" />
                <TextView
                    style="@style/TextAppearance.EMPlay.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/delete_account"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>