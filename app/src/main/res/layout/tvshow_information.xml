<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Poster — left side -->
    <FrameLayout
        android:id="@+id/poster_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:elevation="8dp"
        android:background="@drawable/bg_poster_placeholder"
        android:clipToOutline="true"
        tools:targetApi="s"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/show_poster"
            android:scaleType="centerCrop" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvshow_information_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/black_han_sans"
        android:text="@string/title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Genres -->
    <TextView
        android:id="@+id/tvshow_result_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/genre"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_information_title" />

    <!-- Rating Bar -->
    <RatingBar
        android:id="@+id/tvshow_ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="true"
        android:numStars="5"
        android:rating="0"
        android:scaleX="0.45"
        android:scaleY="0.45"
        android:stepSize="0.5"
        android:theme="@style/RatingBar"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_genres" />

    <!-- Meta info -->
    <TextView
        android:id="@+id/tvshow_result_language"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/language"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_ratingBar" />

    <TextView
        android:id="@+id/tvshow_information_seasons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/season"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_language" />

    <TextView
        android:id="@+id/tvshow_result_episodes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/episode"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_information_seasons" />

    <TextView
        android:id="@+id/tvshow_result_product_country"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/country"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_episodes" />

    <TextView
        android:id="@+id/tvshow_information_first_air_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/release_date"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_product_country" />

    <!-- Trailer + Favourite buttons -->
    <LinearLayout
        android:id="@+id/action_buttons"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_information_first_air_date">

        <Button
            android:id="@+id/trailer_btn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#E53935"
            android:text="@string/trailer"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/add_to_library_btn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#1E1E1E"
            android:drawableStart="@drawable/movie_watchlist"
            android:drawablePadding="4dp"
            android:paddingHorizontal="16dp"
            android:text="@string/watch_list"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Overview -->
    <TextView
        android:id="@+id/tvshow_result_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:justificationMode="inter_word"
        tools:targetApi="o"
        android:text="@string/overview"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_buttons" />

    <TextView
        android:id="@+id/read_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/read_more"
        android:textColor="#E53935"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/tvshow_result_overview"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_overview"/>

</androidx.constraintlayout.widget.ConstraintLayout>