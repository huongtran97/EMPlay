<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_base">

    <!-- HERO BACKDROP (16:9) -->
    <ImageView
        android:id="@+id/backdropView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:background="#1C3036"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient scrim -->
    <View
        android:id="@+id/backdropScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_hero_overlay"
        app:layout_constraintBottom_toBottomOf="@+id/backdropView"
        app:layout_constraintEnd_toEndOf="@+id/backdropView"
        app:layout_constraintStart_toStartOf="@+id/backdropView"
        app:layout_constraintTop_toTopOf="@+id/backdropView" />

    <!-- Back / Share row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_buttons_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_dark"
            app:backgroundTint="#B30B0F19"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_1"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_dark"
            app:backgroundTint="#B30B0F19"
            android:src="@drawable/ic_share"
            app:tint="@color/text_1"
            android:scaleType="centerInside"
            android:contentDescription="@string/share"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- POSTER (2:3, overlapping backdrop) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/poster_container"
        android:layout_width="92dp"
        android:layout_height="132dp"
        android:layout_marginStart="13dp"
        android:layout_marginTop="-44dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#2EEDF0F7"
        app:strokeWidth="0.5dp"
        app:cardBackgroundColor="#171E31"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/backdropView">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/show_poster"
            android:scaleType="centerCrop"
            android:transitionName="poster_transition" />

        <!-- Coming Soon badge -->
        <TextView
            android:id="@+id/coming_soon_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/coming_soon"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_badge_amber"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>

    <!-- TITLE (right of poster) -->
    <TextView
        android:id="@+id/tvshow_title"
        style="@style/TextAppearance.EMPlay.DisplayLg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_1"
        android:lineSpacingMultiplier="1.15"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/poster_container"
        app:layout_constraintBottom_toTopOf="@+id/rating_row"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Teach You a Lesson" />

    <!-- Rating Row -->
    <LinearLayout
        android:id="@+id/rating_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_title">

        <TextView
            android:id="@+id/tvPosterRating"
            style="@style/TextAppearance.EMPlay.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rating_format"
            android:textColor="@color/accent" />

    </LinearLayout>

    <!-- Genres chips -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/tvshow_info_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="5dp"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poster_container"
        app:layout_constraintTop_toBottomOf="@+id/rating_row" />

    <!-- META CHIPS ROW -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/meta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"
        android:layout_marginTop="9dp"
        app:flexWrap="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poster_container">

        <TextView
            android:id="@+id/tv_badge_returning"
            style="@style/TextAppearance.EMPlay.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_badge_returning"
            android:textColor="@color/airing"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1dp"
            android:background="@drawable/bg_chip_cinematic"
            app:backgroundTint="#597FBF9A"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/movie_certification"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            tools:text="14+" />

        <TextView
            android:id="@+id/chip_seasons"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            tools:text="2 seasons" />

        <TextView
            android:id="@+id/chip_episodes"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            tools:text="8 episodes" />

        <TextView
            android:id="@+id/movie_release_date"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            tools:text="2024" />

        <TextView
            android:id="@+id/movie_language"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            tools:text="English" />

        <TextView
            android:id="@+id/movie_product_country"
            style="@style/GenreChipStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            tools:text="Canada" />

    </com.google.android.flexbox.FlexboxLayout>

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/meta_row">

        <!-- Watch Trailer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/trailer_btn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.3"
            android:layout_marginEnd="7dp"
            android:text="@string/action_watch_trailer"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/text_divider_label"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/accent"
            app:cornerRadius="8dp" />

        <!-- My List (Ticket Stub) -->
        <LinearLayout
            android:id="@+id/add_to_library_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ticket_stub"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvMyListLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_btn_mylist"
                android:textColor="@color/text_1"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.0" />

            <TextView
                style="@style/TextAppearance.EMPlay.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memorabilia_admit_one"
                android:textColor="@color/text_3"
                android:letterSpacing="0.1"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <!-- ic_library for code compatibility -->
        <ImageView
            android:id="@+id/ic_library"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- OVERVIEW -->
    <TextView
        android:id="@+id/tvshow_result_overview"
        style="@style/TextAppearance.EMPlay.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="13dp"
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_buttons"
        tools:text="Paul Atreides faces the consequences of the holy war he set in motion, as the empire collapses around him…" />

    <TextView
        android:id="@+id/read_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/read_more"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_meta"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/tvshow_result_overview"
        app:layout_constraintTop_toBottomOf="@+id/tvshow_result_overview" />

    <!-- WHERE TO WATCH -->
    <include
        android:id="@+id/wtw_released"
        layout="@layout/wtw_released_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/read_more_text"
        tools:ignore="NotSibling" />

    <include
        android:id="@+id/wtw_unreleased"
        layout="@layout/wtw_unreleased_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="13dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/read_more_text" />

</androidx.constraintlayout.widget.ConstraintLayout>
